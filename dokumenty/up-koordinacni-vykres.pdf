									<pdfaProperty:name>format</pdfaProperty:name>
									<pdfaProperty:category>external</pdfaProperty:category>
									<pdfaProperty:valueType>Text</pdfaProperty:valueType>
									<pdfaProperty:description>The file format used when saving the resource. Tools and applications should set this property to the save format of the data</pdfaProperty:description>
								</rdf:li>
							</rdf:Seq>
						</pdfaSchema:property>
